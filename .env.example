# =============================================================================
# 复制此文件为 .env 并填入真实值（.env 不会也不允许被提交）
# =============================================================================

# --- LLM Provider ---
# Phase 1 固定为 deepseek，禁止写入源码默认值之外的密钥
LLM_PROVIDER=deepseek

# --- DeepSeek (V4.1 Flash) ---
DEEPSEEK_API_KEY=your_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# --- DeepSeek 调用策略 ---
DEEPSEEK_TIMEOUT_SECONDS=60
DEEPSEEK_MAX_RETRIES=2

# --- 应用 ---
APP_ENV=development
LOG_LEVEL=INFO
# 逗号分隔的前端来源，用于 CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# 无复杂用户系统（§31）：默认用户，可通过 X-User-Id 请求头覆盖
DEFAULT_USER_ID=local-user

# --- 持久化 ---
# SQLite 默认位于 data/sqlite/app.db，通常无需配置
# SQLITE_PATH=/absolute/path/to/app.db

# --- LangGraph Checkpoint（短期记忆，独立文件）---
CHECKPOINT_ENABLED=true
# CHECKPOINT_PATH=/absolute/path/to/checkpoints.db

# --- Agent ---
# 单个节点的最大重试次数（§16）
MAX_RETRIES=2

# --- Embedding（独立于 LLM Provider，§12）---
# 更换模型后必须重建索引（集合会记录 embedding 配置）
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=32
EMBEDDING_QUERY_INSTRUCTION=为这个句子生成表示以用于检索相关文章：

# --- RAG ---
CHUNK_SIZE=800
CHUNK_OVERLAP=150
RETRIEVAL_TOP_K=5
CHROMA_COLLECTION=personal_kb
