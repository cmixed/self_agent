# =============================================================================
# 复制此文件为 backend/.env 并填入真实值（backend/.env 不会也不允许被提交）。
# 仓库根目录的 .env 留给外部工具（如 DeepSeek harness），本应用不读取它。
# =============================================================================

# --- LLM Provider ---
# 可选：deepseek | glm（前端顶栏也可在运行时切换，选择持久化到 data/settings.json，
# 该变量仅作为首次启动默认值）
LLM_PROVIDER=deepseek

# --- DeepSeek (V4.1 Flash) ---
DEEPSEEK_API_KEY=your_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# --- DeepSeek 调用策略 ---
DEEPSEEK_TIMEOUT_SECONDS=60
DEEPSEEK_MAX_RETRIES=2

# --- 自定义 OpenAI 兼容端点（可用 UI 管理，见 README「模型服务」；此处为 .env 方式）---
# 例：Kimi（Moonshot，OpenAI 兼容）
#   CUSTOM_BASE_URL=https://api.moonshot.cn/v1
#   CUSTOM_MODEL=kimi-k3
#   CUSTOM_API_KEY_ENV=MOONSHOT_API_KEY
#   MOONSHOT_API_KEY=你的key
# 例：任意本地/自建 OpenAI 兼容服务（无需密钥）
#   CUSTOM_BASE_URL=http://127.0.0.1:8080/v1
#   CUSTOM_MODEL=local-model
#   CUSTOM_REQUIRES_API_KEY=false
#   CUSTOM_IS_LOCAL=true
CUSTOM_BASE_URL=
CUSTOM_MODEL=
CUSTOM_LABEL=自定义接口
CUSTOM_API_KEY=
CUSTOM_API_KEY_ENV=CUSTOM_API_KEY
CUSTOM_REQUIRES_API_KEY=true
CUSTOM_IS_LOCAL=false
# 自定义端点默认给更宽的超时（本地/自建服务可能较慢）
CUSTOM_TIMEOUT_SECONDS=120
CUSTOM_MAX_RETRIES=2

# --- Ollama（本地模型，OpenAI 兼容端点 http://127.0.0.1:11434/v1）---
# 填好 OLLAMA_MODEL（如 qwen3:4b）后即可在顶栏切换到本地模型；本地服务无需密钥。
# 容器运行时 127.0.0.1 是容器自己，需改为宿主机地址：
#   Podman: OLLAMA_BASE_URL=http://host.containers.internal:11434/v1
#   Docker: OLLAMA_BASE_URL=http://host.docker.internal:11434/v1
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=
OLLAMA_TIMEOUT_SECONDS=300
OLLAMA_MAX_RETRIES=1

# --- GLM（智谱，OpenAI 兼容接口；不使用 GLM 时无需填写）---
GLM_API_KEY=
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
GLM_MODEL=glm-5.3-flash
# 复用同一把 GLM_API_KEY 的额外模型（逗号分隔，可选）。
# 每个模型会成为切换器里的独立条目，例如 GLM_EXTRA_MODELS=glm-5.3-flashx
GLM_EXTRA_MODELS=
GLM_TIMEOUT_SECONDS=60
GLM_MAX_RETRIES=2

# --- 应用 ---
APP_ENV=development
LOG_LEVEL=INFO
# 逗号分隔的前端来源，用于 CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# 无复杂用户系统（§31）：默认用户，可通过 X-User-Id 请求头覆盖
DEFAULT_USER_ID=local-user

# --- 持久化 ---
# SQLite 默认位于 data/sqlite/app.db，通常无需配置
# SQLITE_PATH=/absolute/path/to/app.db

# --- LangGraph Checkpoint（短期记忆，独立文件）---
CHECKPOINT_ENABLED=true
# CHECKPOINT_PATH=/absolute/path/to/checkpoints.db

# 任务中断后可在任务详情页「继续生成」（断点续跑）或「重新生成」（新建运行），
# 无需删除任务；每次尝试都会保留在「执行历史」中。改本文件后需重启后端才生效。

# --- Agent ---
# 单个节点的最大重试次数（§16）
MAX_RETRIES=2
# 长文分章节预算（§15）：TARGET_SECTIONS 是提示词里的目标篇幅，
# MAX_SECTIONS 是实际生成上限（超出会被截断并在进度里说明）。
# 两者夹在 [3, 20]，且 TARGET_SECTIONS 不超过 MAX_SECTIONS。
# 目标总字数很大时建议同步提高 TARGET_SECTIONS（单章约 2000 字），
# 降低单章过长被截断的概率。
TARGET_SECTIONS=6
MAX_SECTIONS=12
# 目标总字数（软目标）：按章节数分摊后写进写作/校验提示词，夹在 [1500, 40000]。
# 注意：这不是 max_tokens 硬上限——硬截断只会得到半截章节；
# 真正的截断防护是解析 finish_reason=length 并如实提示。
TARGET_TOTAL_CHARS=6000

# --- 技能 ---
# 从文档生成技能时单次送入模型的最大字符数；长文档会按此切块提炼，
# 最多 6 段，超出部分在结果里如实提示（不再整体截断到只看开头）。
SKILL_GENERATE_MAX_CHARS=12000
# 技能目录（文件是唯一内容源）：<SKILLS_DIR>/<skill_id>/SKILL.md + 附件。
# 默认 data/skills；旧的 SQLite 技能表会在首次启动时迁移到这里并删除。
# SKILLS_DIR=/absolute/path/to/data/skills
# 启动时把内置技能包复制到技能目录（已存在的不覆盖）；默认关闭。
# SEED_BUILTIN_SKILLS=true

# --- Embedding（独立于 LLM Provider，§12）---
# 更换模型后必须重建索引（集合会记录 embedding 配置）
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=32
EMBEDDING_QUERY_INSTRUCTION=为这个句子生成表示以用于检索相关文章：
# 容器运行时模型缓存固定到 data/hf-cache（compose 设置 HF_HOME），无需配置。
# 网络受限时可指定镜像源（同样适用于本地开发）：
# HF_ENDPOINT=https://hf-mirror.com

# --- RAG ---
# 任务检索范围由前端选择（类别 / 单文档），无需配置；缺省检索整个知识库
CHUNK_SIZE=800
CHUNK_OVERLAP=150
RETRIEVAL_TOP_K=5
CHROMA_COLLECTION=personal_kb

# --- 邮件发送（把生成结果发送到邮箱）---
# 不配置时「发送到邮箱」会返回 503，不影响其它功能。
# 密码只允许写在这里或环境变量，禁止提交 backend/.env。
#
# QQ 邮箱：SMTP_HOST=smtp.qq.com  SMTP_PORT=465  SMTP_SECURITY=ssl
#           SMTP_PASSWORD 填「授权码」，不是邮箱登录密码
# 163 邮箱：SMTP_HOST=smtp.163.com SMTP_PORT=465  SMTP_SECURITY=ssl
# Gmail：   SMTP_HOST=smtp.gmail.com SMTP_PORT=587 SMTP_SECURITY=starttls
#           使用「应用专用密码」
# 本地中继：SMTP_SECURITY=none（仅限可信内网）
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURITY=ssl
SMTP_USERNAME=
SMTP_PASSWORD=
# 发件人地址；留空时回退到 SMTP_USERNAME
SMTP_FROM=
SMTP_FROM_NAME=个人知识库 Agent
SMTP_TIMEOUT_SECONDS=15
# 同一任务 + 同一收件人的发送冷却（秒）；0 = 不限制
EMAIL_COOLDOWN_SECONDS=30
