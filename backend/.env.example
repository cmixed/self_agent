# =============================================================================
# 复制此文件为 backend/.env 并填入真实值（backend/.env 不会也不允许被提交）。
# 仓库根目录的 .env 留给外部工具（如 DeepSeek harness），本应用不读取它。
# =============================================================================

# --- LLM Provider ---
# 可选：deepseek | glm（前端顶栏也可在运行时切换，选择持久化到 data/settings.json，
# 该变量仅作为首次启动默认值）
LLM_PROVIDER=deepseek

# --- DeepSeek (V4.1 Flash) ---
DEEPSEEK_API_KEY=your_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# --- DeepSeek 调用策略 ---
DEEPSEEK_TIMEOUT_SECONDS=60
DEEPSEEK_MAX_RETRIES=2

# --- 自定义 OpenAI 兼容端点（可用 UI 管理，见 README「模型服务」；此处为 .env 方式）---
# 例：Kimi（Moonshot，OpenAI 兼容）
#   CUSTOM_BASE_URL=https://api.moonshot.cn/v1
#   CUSTOM_MODEL=kimi-k3
#   CUSTOM_API_KEY_ENV=MOONSHOT_API_KEY
#   MOONSHOT_API_KEY=你的key
# 例：任意本地/自建 OpenAI 兼容服务（无需密钥）
#   CUSTOM_BASE_URL=http://127.0.0.1:8080/v1
#   CUSTOM_MODEL=local-model
#   CUSTOM_REQUIRES_API_KEY=false
#   CUSTOM_IS_LOCAL=true
CUSTOM_BASE_URL=
CUSTOM_MODEL=
CUSTOM_LABEL=自定义接口
CUSTOM_API_KEY=
CUSTOM_API_KEY_ENV=CUSTOM_API_KEY
CUSTOM_REQUIRES_API_KEY=true
CUSTOM_IS_LOCAL=false
# 自定义端点默认给更宽的超时（本地/自建服务可能较慢）
CUSTOM_TIMEOUT_SECONDS=120
CUSTOM_MAX_RETRIES=2

# --- Ollama（本地模型，OpenAI 兼容端点 http://127.0.0.1:11434/v1）---
# 填好 OLLAMA_MODEL（如 qwen3:4b）后即可在顶栏切换到本地模型；本地服务无需密钥。
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=
OLLAMA_TIMEOUT_SECONDS=300
OLLAMA_MAX_RETRIES=1

# --- GLM（智谱，OpenAI 兼容接口；不使用 GLM 时无需填写）---
GLM_API_KEY=
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
GLM_MODEL=glm-5.3-flash
GLM_TIMEOUT_SECONDS=60
GLM_MAX_RETRIES=2

# --- 应用 ---
APP_ENV=development
LOG_LEVEL=INFO
# 逗号分隔的前端来源，用于 CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# 无复杂用户系统（§31）：默认用户，可通过 X-User-Id 请求头覆盖
DEFAULT_USER_ID=local-user

# --- 持久化 ---
# SQLite 默认位于 data/sqlite/app.db，通常无需配置
# SQLITE_PATH=/absolute/path/to/app.db

# --- LangGraph Checkpoint（短期记忆，独立文件）---
CHECKPOINT_ENABLED=true
# CHECKPOINT_PATH=/absolute/path/to/checkpoints.db

# 任务中断后可在任务详情页「继续生成」（断点续跑）或「重新生成」（新建运行），
# 无需删除任务；每次尝试都会保留在「执行历史」中。改本文件后需重启后端才生效。

# --- Agent ---
# 单个节点的最大重试次数（§16）
MAX_RETRIES=2
# 长文分章节预算（§15）：TARGET_SECTIONS 是提示词里的目标篇幅，
# MAX_SECTIONS 是实际生成上限（超出会被截断并在进度里说明）。
# 两者夹在 [3, 20]，且 TARGET_SECTIONS 不超过 MAX_SECTIONS。
TARGET_SECTIONS=6
MAX_SECTIONS=12
# 目标总字数（软目标）：按章节数分摊后写进写作/校验提示词，夹在 [1500, 40000]。
# 注意：这不是 max_tokens 硬上限——硬截断只会得到半截章节；
# 真正的截断防护是解析 finish_reason=length 并如实提示。
TARGET_TOTAL_CHARS=6000

# --- Embedding（独立于 LLM Provider，§12）---
# 更换模型后必须重建索引（集合会记录 embedding 配置）
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=32
EMBEDDING_QUERY_INSTRUCTION=为这个句子生成表示以用于检索相关文章：

# --- RAG ---
# 任务检索范围由前端选择（类别 / 单文档），无需配置；缺省检索整个知识库
CHUNK_SIZE=800
CHUNK_OVERLAP=150
RETRIEVAL_TOP_K=5
CHROMA_COLLECTION=personal_kb
