// Pyright 配置（VS Code 的 Pylance 使用同一套引擎与规则）。
//
// 只覆盖应用代码 `app/`：类型问题的修复目标就是这 26 条 → 0，
// 并且以 `uv run pyright` 作为门禁，避免以后再次退化。
//
// `tests/` 暂不纳入：测试夹具大量在裸 dict 与 TypedDict 之间互转，
// 清理由单独一轮（约 200 条）。等清理完成后再把 include 改成 ["app", "tests"]。
{
  "include": ["app"],
  "exclude": ["**/__pycache__", ".venv"],

  // 与 requires-python / .python-version 对齐
  "pythonVersion": "3.14",

  // 用项目自己的虚拟环境解析第三方包（uv sync 生成）
  "venvPath": ".",
  "venv": ".venv",

  // 与 Pylance 默认档一致：报真错误、不纠缠未标注的函数
  "typeCheckingMode": "standard",

  // 过期的 `# type: ignore` 也要报：否则被忽略的错误会悄悄回来
  "reportUnnecessaryTypeIgnoreComment": true,
  "reportUnusedImport": true,
  "reportUnusedVariable": true
}
